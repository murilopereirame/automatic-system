# Login token for the web UI and API. Use a long random value, e.g. `openssl rand -hex 32`.
AUTOWORKER_TOKEN=

# Passphrase that encrypts stored secrets. Keep it stable: changing it makes stored secrets unreadable.
AUTOWORKER_SECRET_KEY=

# Public base URL, used for links in notifications. Example: https://autoworker.example.com
AUTOWORKER_PUBLIC_URL=

# Optional overrides
# AUTOWORKER_PORT=8080
# AUTOWORKER_MEMORY=8g
# AUTOWORKER_CPUS=4
# AUTOWORKER_IMAGE=ghcr.io/murilopereirame/automatic-system:latest
